<sdf version="1.6">
    <model name='DJI550_with_standoffs'>
    <!-- Typhoon H body -->
    <!-- <pose>1.0 1.0 3.0 0 0 0</pose> -->
    <pose>0.0 0.0 0.1 0 0 0</pose>
    <link name='base_link'>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <inertial>
        <pose frame=''>0.001005 0 -0.0090035 0 -0 0</pose>
        <!-- masa original Typhoon base_link 2.02 -->
        <!-- <mass>2.02</mass>  -->
        <mass>2.6</mass>
        <inertia>
          <ixx>0.026</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.026</iyy>
          <iyz>0</iyz>
          <izz>0.0515</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose frame=''>0 0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.67 0.67 0.15</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
