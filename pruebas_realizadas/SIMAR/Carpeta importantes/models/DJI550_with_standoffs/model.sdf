    <joint name='left_leg_joint' type='fixed'>
      <child>left_leg</child>
      <parent>base_link</parent>
      <pose frame=''>0.00026 -0.040515 -0.048 0 0 0</pose>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>1</upper>
          <effort>100</effort>
